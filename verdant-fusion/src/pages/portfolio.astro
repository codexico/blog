---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectModal from "../components/ProjectModal.astro";
import HeroCollage from "../components/HeroCollage.astro";
import { shuffle } from "../utils/posts";
import {
  projects,
  projectCategories,
  type ProjectCategoryKey,
} from "../data/projects";

// O código dinâmico que lista as categorias abaixo substitui esses filtros manuais.

// Projetos com imagens para o Hero Collage (estilo Scattered)
const onlyProjectsWithImages = projects.filter((p) => p.image);

const imagesAndTitles = onlyProjectsWithImages.flatMap((project) => {
  const allimagesfromProject = [project.image, ...(project.gallery || [])];

  return allimagesfromProject.map((img: any) => {
    return { title: project.title, img };
  });
});

const shuffledImagesAndTitles = shuffle(imagesAndTitles);
---

<PortfolioLayout
  title={"Portfólio Desenvolvedor Full Stack"}
  description={"Portfólio de Francisco Kahil. Desenvolvedor Full Stack com mais de 15 anos de experiência criando aplicações escaláveis em JavaScript, TypeScript e React."}
>
  <HeroCollage imagesAndTitles={shuffledImagesAndTitles} />

  <div class="portfolio-intro">
    <h3 class="portfolio-intro-title">Olá, eu sou o Francisco Kahil 👋</h3>
    <p class="portfolio-intro-subtitle">
      Aqui você encontra uma seleção de alguns dos muitos trabalhos, aplicativos
      e experimentos desenvolvidos ao longo da minha carreira de mais de 15 anos
      como desenvolvedor full stack.
    </p>
  </div>

  {
    Object.keys(projectCategories).map((key) => {
      const category = projectCategories[key as ProjectCategoryKey];
      const categoryProjects = projects.filter((p) =>
        p.category.includes(category)
      );

      // Omitir categorias sem projetos
      if (categoryProjects.length === 0) return null;

      return (
        <div class="list-section">
          <div class="list-section-header">
            <h2 class="list-section-title">{category.title}</h2>
            <p class="list-section-subtitle">{category.description}</p>
          </div>
          <div class="list-grid">
            {categoryProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      );
    })
  }

  <!-- Dialog Modal for Project Details -->
  <dialog id="project-modal">
    <button class="dialog-close" aria-label="Fechar" id="close-modal"
      >&times;</button
    >
    <div class="dialog-content" id="modal-content">
      <!-- Injetado via JS -->
    </div>
  </dialog>

  <style>
    .portfolio-intro {
      margin-bottom: 3rem;
      color: var(--muted-foreground);
      text-align: center;
    }
    .portfolio-intro-subtitle {
      line-height: 1.4;
    }

    @media (min-width: 768px) {
      .portfolio-intro-subtitle {
        line-height: 1.3;
        max-width: 50%;
        margin: 0 auto;
      }
    }

    .list-section {
      display: flex;
      gap: 2rem;
      margin-bottom: 2rem;
      align-items: flex-start;
    }
    .list-section-header {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 240px;
      top: 2rem;
      flex-shrink: 0;
    }
    @media (min-width: 768px) {
      .list-section-header {
        position: sticky;
      }
    }
    .list-section-title {
      font-size: 1.2rem;
      margin: 0;
      color: rgb(from var(--card-title) r g b / 1);
    }
    .list-section-subtitle {
      font-size: 1rem;
      margin: 0;
      color: rgb(from var(--text-color) r g b);
      position: sticky;
      top: 3rem;
    }

    .list-grid {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.2rem;
    }
    .list-item {
      background: var(--background-alt);
      border: 1px solid var(--line-shadow-color);
      border-radius: 8px;
      padding: 1rem;
      cursor: pointer;
      transition: border-color 0.2s;
    }
    .list-item:hover {
      border-color: var(--title-hover);
    }
    .list-item h4 {
      margin: 0 0 0.5rem 0;
      font-size: 1.1rem;
      color: var(--title-color);
    }
    .list-item p {
      font-size: 0.9rem;
      margin: 0;
      color: var(--muted-foreground);
    }

    @media (max-width: 768px) {
      .list-section {
        flex-direction: column;
        gap: 1rem;
      }
      .list-section h2 {
        flex: auto;
        position: static;
      }
    }
  </style>

  <!-- Renderizando todos os modais da página nativamente via SSG -->
  {projects.map((project) => <ProjectModal project={project} />)}
</PortfolioLayout>
