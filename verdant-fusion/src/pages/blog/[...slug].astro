---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import type { Comment, CommentPost, CommentList } from "../../types/comments";
import commentList from "../../data/comments_extracted.json"; // Carrega o JSON
import Comments from "../../components/Comments.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const comentariosDoPost = (commentList as CommentList)[post.id]?.comments || [];
---

<BlogPost {...post.data}>
  <Content />
  <Comments comentariosDoPost={comentariosDoPost} />
</BlogPost>
