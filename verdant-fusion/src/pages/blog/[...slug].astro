---
import { getCollection, render } from "astro:content";

import BlogPost from "../../layouts/BlogPost.astro";
import Comments from "../../components/Comments.astro";

import commentList from "../../data/comments_extracted.json";
import type { CommentList } from "../../types/comments";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);

const comentariosDoPost = (commentList as CommentList)[post.id]?.comments || [];
---

<BlogPost {...post.data}>
  <Content />
  <Comments comentariosDoPost={comentariosDoPost} />
</BlogPost>
