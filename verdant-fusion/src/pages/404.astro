---
// src/pages/404.astro
// Primeiro tenta encontrar um post correspondente ao slug da URL,
// se encontrar, redireciona para a URL canônica do post.
// Se não encontrar, exibe a página 404 personalizada.
export const prerender = false; // Força esta rota a rodar sob demanda na Cloudflare Edge

import { postRedirectHandler } from "../utils/posts";

const redirectResult = await postRedirectHandler(Astro.request.url);

if (redirectResult) {
  return Astro.redirect(redirectResult.url, redirectResult.status);
}

// Se não encontrar nenhum post correspondente, renderiza a página 404 personalizada
import Layout from "../layouts/PageLayout.astro";
---

<Layout title="Página não encontrada" description="Sobre mim e sobre o blog">
  <h1>Erro 404</h1>
  <p>O conteúdo que você procura foi movido ou não existe.</p>
  <a href="/">Voltar para a Home</a>
</Layout>
