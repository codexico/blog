---
import type { Project } from "../data/projects";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"
);
---

<dialog id={`modal-${project.id}`} class="project-modal">
  <form method="dialog">
    <button class="dialog-close" aria-label="Fechar">&times;</button>
  </form>

  <div class="dialog-content">
    {
      project.image && images[project.image.src] ? (
        <Image
          src={images[project.image.src]()}
          alt={project.title}
          class="modal-main-img"
          width={project.image.width}
          height={project.image.height}
          widths={[240, 540, 720, project.image.width]}
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${project.image.width}px`}
        />
      ) : (
        project.image && (
          <img
            src={project.image.src}
            alt={project.title}
            class="modal-main-img"
          />
        )
      )
    }

    {
      project.gallery && project.gallery.length > 0 && (
        <div class="modal-gallery-container">
          {project.image && images[project.image.src] ? (
            <Image
              src={images[project.image.src]()}
              alt={`${project.title} screenshot`}
              loading="lazy"
              class="gallery-thumb"
              width={project.image.width}
              height={project.image.height}
              widths={[240, 540, 720, project.image.width]}
              sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${project.image.width}px`}
              onmouseover="this.style.transform='scale(1.05)'"
              onmouseout="this.style.transform='scale(1)'"
            />
          ) : (
            project.image && (
              <img
                src={project.image.src}
                alt={`${project.title} screenshot`}
                loading="lazy"
                class="gallery-thumb"
                onmouseover="this.style.transform='scale(1.05)'"
                onmouseout="this.style.transform='scale(1)'"
              />
            )
          )}

          {project.gallery.map((g) => {
            if (images[g.src]) {
              return (
                <Image
                  src={images[g.src]()}
                  alt={`${project.title} screenshot`}
                  loading="lazy"
                  class="gallery-thumb"
                  width={g.width}
                  height={g.height}
                  widths={[240, 540, 720, g.width]}
                  sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${g.width}px`}
                  onmouseover="this.style.transform='scale(1.05)'"
                  onmouseout="this.style.transform='scale(1)'"
                />
              );
            }
            return (
              <img
                src={g.src}
                alt={`${project.title} screenshot`}
                loading="lazy"
                class="gallery-thumb"
                onmouseover="this.style.transform='scale(1.05)'"
                onmouseout="this.style.transform='scale(1)'"
              />
            );
          })}
        </div>
      )
    }

    <h2>{project.title}</h2>
    <span class="year">
      {project.category.map((c) => c.title).join(", ")} &bull; {
        project.year || ""
      }
    </span>

    {
      project.tags && project.tags.length > 0 && (
        <div class="project-tags">
          {project.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }

    <p>{project.description}</p>

    {
      project.link && (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="modal-link"
        >
          Acessar Projeto &rarr;
        </a>
      )
    }
  </div>
</dialog>

<style>
  dialog {
    border: 1px solid var(--line-shadow-color);
    border-radius: 12px;
    padding: 1.5rem;
    box-sizing: border-box; /* Isso garante que o modal tenha exatamente 90% de largura, sem o padding somar a mais */
    max-width: 700px;
    width: 90%;
    background: var(--background);
    color: var(--text-color);
    box-shadow: 0 10px 40px rgb(0, 0, 0, 0.8);
    margin: auto;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }
  @media (min-width: 768px) {
    dialog {
      padding: 2rem;
    }
  }
  dialog::backdrop {
    background: rgb(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .dialog-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--background);
    border: 1px solid var(--line-shadow-color);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-color);
    transition: all 0.2s;
    z-index: 10;
    box-shadow: 0 4px 10px rgb(0, 0, 0, 0.3);
  }
  .dialog-close:hover {
    color: var(--title-hover);
    transform: scale(1.1);
  }

  .modal-main-img {
    max-height: 350px;
    object-fit: contain;
    width: 100%;
    border-radius: 8px;
    margin-bottom: 1rem;
    background: var(--background-alt);
    transition: opacity 0.2s ease-in-out;
  }

  .modal-gallery-container {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    padding-bottom: 10px;
  }
  .modal-gallery-container img {
    height: 120px;
    width: auto;
    flex-shrink: 0;
    border: 1px solid var(--line-shadow-color);
    border-radius: 8px;
    margin-bottom: 0;
    cursor: pointer;
    transition: transform 0.2s;
  }

  h2 {
    margin-top: 0;
    color: var(--title-color);
  }
  .year {
    font-size: 0.9rem;
    color: var(--muted-foreground);
    margin-bottom: 1rem;
    display: block;
  }
  .project-tags {
    margin-bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--accent);
    color: var(--background);
    border-radius: 12px;
    font-weight: bold;
  }
  .modal-link {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--background);
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
  }
</style>

<script>
  // Lógica do carrossel no Modal isolada para cada componente instanciado
  const modals = document.querySelectorAll(".project-modal");
  const eventHandler = (
    event: TouchEvent | MouseEvent,
    mainImg: HTMLImageElement
  ) => {
    const target = event.target as HTMLImageElement;
    mainImg.style.opacity = "0.7";
    setTimeout(() => {
      mainImg.src = target.src;
      if (target.srcset) mainImg.srcset = target.srcset;
      if (target.sizes) mainImg.sizes = target.sizes;
      mainImg.style.opacity = "1";
    }, 50);
  };
  modals.forEach((modal) => {
    const mainImg = modal.querySelector(".modal-main-img") as HTMLImageElement;
    const thumbs = modal.querySelectorAll(".gallery-thumb");

    if (mainImg && thumbs.length > 0) {
      thumbs.forEach((thumb) => {
        thumb.addEventListener("mouseenter", (event) =>
          eventHandler(event as MouseEvent, mainImg)
        );
        thumb.addEventListener("touchstart", (event) =>
          eventHandler(event as TouchEvent, mainImg)
        );
      });
    }

    // Fecha o modal ao clicar fora dele (no ::backdrop)
    modal.addEventListener("click", (e) => {
      const dialog = e.currentTarget as HTMLDialogElement;
      const rect = dialog.getBoundingClientRect();
      const ev = e as MouseEvent;
      // Se clicou fora dos limites da caixa do dialog
      if (
        ev.clientY < rect.top ||
        ev.clientY > rect.bottom ||
        ev.clientX < rect.left ||
        ev.clientX > rect.right
      ) {
        dialog.close();
      }
    });
  });
</script>
